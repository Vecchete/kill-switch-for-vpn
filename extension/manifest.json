{
  "manifest_version": 3,
  "name": "Kill Switch for VPN",
  "version": "1.0.0",
  "description": "Blocks web traffic in your tabs while no VPN extension is connected, and reloads the blocked tabs once it connects.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Kill Switch for VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["declarativeNetRequest", "proxy", "storage", "webNavigation"]
}
